<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor">

    <!-- Fundo que troca entre as 5 imagens (tela_car_1 a tela_car_5) via UpdateActivity.java -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/tela_car_1"
        android:contentDescription="@null" />

    <!-- Leve escurecida no canto inferior direito, so pra dar contraste ao status -->
    <View
        android:layout_width="@dimen/_180sdp"
        android:layout_height="@dimen/_120sdp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/gradient_card_bottom" />

    <!-- Copyright, canto superior direito -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ahahaha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/_10sdp"
        android:fontFamily="@font/gotham"
        android:text="@string/ahahaha"
        android:textColor="#B3FFFFFF"
        android:textSize="@dimen/_8ssp"
        android:textStyle="bold" />

    <!-- Status + spinner, canto inferior direito -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/_14sdp"
        android:background="@drawable/status_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_10sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingBottom="@dimen/_6sdp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:indeterminate="true"
            android:indeterminateTint="#FFFFFF" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/update_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:fontFamily="@font/gotham"
            android:text="@string/updating_game"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Views mantidas ocultas so pra nao quebrar o UpdateActivity.java, que ainda
         escreve texto nelas (percentual, nome do arquivo, tamanho) - nao aparecem
         mais na tela, mas continuam existindo por baixo dos panos. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/filename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</FrameLayout>
