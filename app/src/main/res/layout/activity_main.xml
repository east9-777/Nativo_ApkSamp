<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Imagem de fundo em tela cheia. TODO: trocar pela arte final quando o usuario fornecer. -->
    <ImageView
        android:id="@+id/mainBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/launcher_bg" />

    <!-- Escurece a parte de baixo pra dar legibilidade ao texto de players e ao botao Conectar.
         Usa dp fixo (nao sdp) de proposito: o app roda em paisagem, e sdp escala pela MENOR
         largura do aparelho (que em paisagem vira a altura da tela) - com _120sdp isso comia
         mais de 1/3 da altura da tela e parecia uma faixa preta enorme. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/gradient_bottom_scrim" />

    <!-- Coluna de redes sociais, lado esquerdo. TODO: preencher os links quando fornecidos. -->
    <LinearLayout
        android:id="@+id/socialBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/_14sdp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnDiscord"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/circle_icon_bg"
            android:contentDescription="@string/discord"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_discord" />

        <ImageButton
            android:id="@+id/btnYoutube"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/circle_icon_bg"
            android:contentDescription="YouTube"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_youtube" />

        <ImageButton
            android:id="@+id/btnInstagram"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/circle_icon_bg"
            android:contentDescription="Instagram"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_instagram" />

    </LinearLayout>

    <!-- Campo de nickname, canto superior esquerdo. O jogador preenche aqui e o botao
         Conectar so usa esse valor - nao existe mais a tela separada pedindo o nick. -->
    <LinearLayout
        android:id="@+id/nicknameArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_54sdp"
        android:background="@drawable/server_picker_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_14sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingEnd="@dimen/_14sdp"
        android:paddingBottom="@dimen/_6sdp">

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_people" />

        <EditText
            android:id="@+id/nicknameField"
            android:layout_width="@dimen/_110sdp"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/montserrat_bold"
            android:hint="@string/nickname_hint"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:maxLength="24"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textColorHint="#99FFFFFF"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Botao do topo direito: configuracoes -->
    <LinearLayout
        android:id="@+id/topRightBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/_14sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_button_dark"
            app:backgroundTint="@null"
            android:fontFamily="@font/montserrat_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="@string/settings"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_9ssp"
            app:elevation="0dp"
            app:icon="@drawable/ic_settings"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart" />

    </LinearLayout>

    <!-- Card do servidor escolhido (toca pra trocar) + botao de conectar, canto inferior direito -->
    <LinearLayout
        android:id="@+id/bottomConnectArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="@dimen/_18sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Mostra o servidor selecionado no momento; toque abre o painel de escolha de servidor -->
        <LinearLayout
            android:id="@+id/serverPickerCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/server_picker_bg"
            android:clickable="true"
            android:contentDescription="@string/tap_to_choose_server"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/_46sdp"
            android:orientation="vertical"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_8sdp">

            <TextView
                android:id="@+id/serverPickerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold"
                android:text="@string/server1_name_default"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_people" />

                <TextView
                    android:id="@+id/playersOnlineText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="@string/checking_players"
                    android:textColor="#CCCCCC"
                    android:textSize="@dimen/_8ssp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/pill_button_accent"
            app:backgroundTint="@null"
            android:fontFamily="@font/montserrat_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/_150sdp"
            android:paddingStart="@dimen/_20sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingEnd="@dimen/_20sdp"
            android:paddingBottom="@dimen/_10sdp"
            android:text="@string/connect"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            app:elevation="0dp" />

    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/ahahaha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="@dimen/_10sdp"
        android:elevation="@dimen/_4sdp"
        android:fontFamily="sans-serif"
        android:text="ahahaha"
        android:textColor="@color/grey"
        android:textSize="@dimen/_7ssp"
        android:textStyle="bold" />

    <!-- Painel de configuracoes: ocupa a tela toda, fica escondido ate o usuario tocar na engrenagem -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:layout="@layout/fragment_settings_page" />

    <!-- Painel de escolha de servidor: ocupa a tela toda, fica escondido ate o usuario tocar no card do servidor -->
    <include
        android:id="@+id/chooseServerContainer"
        layout="@layout/panel_choose_server"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnCloseSettings"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="@dimen/_10sdp"
        android:background="@drawable/circle_icon_bg"
        android:contentDescription="@string/cancel"
        android:elevation="@dimen/_6sdp"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/arrow_back"
        android:visibility="gone" />

</RelativeLayout>
